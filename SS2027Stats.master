<style type="text/css">
   /* #insideWrap
    {
        background: url(/Images/ekoss27-banner.jpg) no-repeat top left !important;
        background-size: 11vw auto !important;
    }*/

    

    @media only screen and (max-width: 1340px) and (min-width: 1000px) {
        #listStats
        {
            grid-template-columns: 1fr 1fr 1fr!important;
        }
        #listStats li {
            width: 17vw!important;
            height: calc(17vw - 50px)!important;
        }
    }

    @media only screen and (max-width: 999px) {
        #listStats
        {
            grid-template-columns: 1fr 1fr!important;
        }
    }
    @media only screen and (max-width: 767px) {
        .button-primary, body .button
        {
            display: inline-block!important;
            
            float: left;
            position: relative;
        }

        #buttonsTop
        {
            float: left!important;
            top: 10px;
            position: relative;
        }
    }
    h1
    {
        /*display: none!important;*/
        color:#2f1a51!important;
    }

    #listStats
    {
        margin:0 -5vw;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        grid-column-gap: 10px;
        grid-row-gap: 10px;
        align-items: center;
    }

    #listStats li
    {
        padding:50px 10px 10px 10px;
        text-align: center;
        border-radius: 50%;
        border:1px solid var(--pink);
/*        border:7px solid var(--green);*/
        width:12vw; height: calc(12vw - 50px);
        line-height: 1.2!important;
    }

    #listStats li:before
    {
        display: none!important;
    }

    #listStats li strong
    {
        display: block;
        font-size: 50px;
        font-weight: 900;
        color: var(--purple)!important;
    }

    .button, #insideContent a
    {
        transition: all 0.3s ease;
    }

    .button:hover
    {
        transform: scale(1.05);
        -ms-transform: scale(1.05);
        -moz-transform: scale(1.05);
        -webkit-transform: scale(1.05);
        -o-transform: scale(1.05);
        cursor: pointer;
    }
    #leftMenu{
        padding-top:0;
        padding-left:20px;
        background-color:#2f1a51!important;
    }
    #leftMenu ul li a,
    #leftMenu ul li a:after {
        color:#fff!important;
    }
    #leftMenu ul li a:before{
        background-color:#fff!important;
    }

    #leftMenu ul.sm-blue>li>a:after {
        background: url(/Images/menu-left-arrowNew.png) no-repeat;
        background-size: contain;
    }
    
    #leftMenu li a.has-submenu.current:after,
    #leftMenu li a.has-submenu:hover:after{
        bottom:-13px;
    }
    body #leftMenu .sm-blue ul a.has-submenu:after{
        background: url(/Images/plus-new-white.svg) no-repeat !important;
    }
      /*#insideWrap {
          background:#2f1a51 !important;
      }*/
      body.yes-inside-menu #rightInside{
          background:#fff!important;
      }

    @media only screen and (min-width: 768px) {

       #insideWrap {
            position: relative;
        }

        #insideWrap::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: calc((100% - 1200px) / 2);
            height: 100%;
            background: url(/Images/ekoss27-banner.jpg) no-repeat top right;
            background-size: 100% 100%;
            z-index: 0;
            pointer-events: none;
            transform: rotate(180deg);
        }
    }
 

    #mainContentInside>div, body #mainContentInside {
        background-color: rgba(255, 255, 255, 0.2);
    }

    .inside.insideMainTemplate.foliage #insideMemberSlider:before {
        content: "";
        background-image:  none!important;
        bottom:248px;
    }
    .inside.insideMainTemplate.foliage #insideMemberSlider:after {
        content: "";
        background-image: none!important;
    }

    #listStats li {
      opacity: 0;
      transform: scale(0.8);
      transition: opacity 0.5s, transform 0.5s;
    }

    /* Apply animation effect when the 'show' class is added */
    #listStats li.show {
      opacity: 1;
      transform: scale(1);
    }

    .nGY2GThumbnail{
        top:0!important;
    }
       
</style>
<script type="text/javascript">

    document.addEventListener("DOMContentLoaded", function() {
  const listItems = document.querySelectorAll("#listStats li");
  
  // Function to animate each list item
  function animateListItem(index) {
    if (index < listItems.length) {
      listItems[index].classList.add("show");
      setTimeout(function() {
        animateListItem(index + 1);
      }, 200); // Adjust the delay between each animation
    }
  }

  // Function to check if an element is in view
  function isInView(element) {
    const rect = element.getBoundingClientRect();
    return (
      rect.top >= 0 &&
      rect.left >= 0 &&
      rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
      rect.right <= (window.innerWidth || document.documentElement.clientWidth)
    );
  }

  // Start animation when the list is in view
  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        animateListItem(0);
        observer.unobserve(entry.target);
      }
    });
  });

  // Observe each list item
  listItems.forEach(function(item) {
    observer.observe(item);
  });
});
</script>
</head>
