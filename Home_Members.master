    @media (max-width: 420px) {
        html body.home-member .welcome-heading {
            padding-left: 0;
            padding-right: 0;
        }

        html body.home-member .static-welcome-search {
            align-items: stretch;
        }

        html body.home-member .welcome-search-btn {
            min-width: 58px;
            padding: 0 11px;
        }

        html body.home-member div.quickWrapper.QuickLinkIcons {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        html body.home-member .whats-new-row {
            padding-right: 11px;
            padding-left: 11px;
        }

        html body.home-member .whats-new-action {
            font-size: 8px;
        }
    }



    /* =========================================================
       FINAL FIX - Real Conversations content overflow
       The carousel/image inside .editable-zone-col was larger
       than its allocated header area and was overflowing into
       the event/banner section.
       ========================================================= */

    html body.home-member .editable-zone-col {
        position: absolute;
        top: 0;
        right: 0;
        width: 273px;
        height: 98px;
        min-width: 0;
        box-sizing: border-box;
        overflow: hidden;
        z-index: 2;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick {
        position: relative !important;
        width: 100% !important;
        height: 98px !important;
        max-width: 100% !important;
        overflow: hidden !important;
        box-sizing: border-box !important;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        width: 100% !important;
        height: 98px !important;
        max-width: 100% !important;
        overflow: hidden !important;
        box-sizing: border-box;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap img {
        display: block;
        flex: 0 0 100px;
        width: 100px !important;
        max-width: 100px !important;
        height: 66px !important;
        max-height: 66px !important;
        margin-top: 18px;
        object-fit: contain;
        object-position: center;
        box-sizing: border-box;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap br {
        display: none;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap > a {
        display: block;
        flex: 1 1 auto;
        min-width: 0;
        max-width: 135px;
        margin-top: 21px;
        color: #17172a;
        font-size: 9px;
        font-weight: 600;
        line-height: 1.3;
        text-decoration: none;
        overflow-wrap: break-word;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap > a:hover {
        text-decoration: underline;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick [id$="_tdEdit"] {
        position: absolute !important;
        right: 0 !important;
        bottom: 0 !important;
        z-index: 3;
    }

    /* Keep the event/banner completely below the header conversation area. */
    html body.home-member #insideBanner {
        position: relative;
        z-index: 1;
        clear: both;
    }

    @media (max-width: 760px) {
        html body.home-member .editable-zone-col {
            position: static;
            width: 100%;
            height: auto;
            overflow: visible;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick,
        html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap {
            height: auto !important;
            min-height: 58px;
            overflow: visible !important;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap img {
            flex-basis: 86px;
            width: 86px !important;
            max-width: 86px !important;
            height: 58px !important;
            max-height: 58px !important;
            margin-top: 0;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap > a {
            margin-top: 2px;
            max-width: none;
        }
    }



    /* =========================================================
       REAL CONVERSATIONS - SHOW ALL CONTENT
       Do not hide the logo, text/link, or editor.
       The editor is placed below the Real Conversations logo.
       ========================================================= */

    html body.home-member .editable-zone-col {
        position: absolute;
        top: 0;
        right: 0;
        width: 273px;
        height: 112px;
        min-width: 0;
        box-sizing: border-box;
        overflow: visible !important;
        z-index: 2;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick {
        position: relative !important;
        display: block !important;
        width: 100% !important;
        height: auto !important;
        max-width: 100% !important;
        overflow: visible !important;
        box-sizing: border-box !important;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap {
        position: relative !important;
        display: grid !important;
        grid-template-columns: 94px minmax(0, 1fr) !important;
        grid-template-rows: 63px auto !important;
        column-gap: 10px !important;
        width: 100% !important;
        height: auto !important;
        max-width: 100% !important;
        overflow: visible !important;
        box-sizing: border-box !important;
        align-items: start !important;
    }

    /* Real Conversations logo - visible and contained in its area. */
    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap img {
        display: block !important;
        grid-column: 1 !important;
        grid-row: 1 !important;
        width: 94px !important;
        max-width: 94px !important;
        height: 63px !important;
        max-height: 63px !important;
        margin: 0 !important;
        object-fit: contain !important;
        object-position: center !important;
        box-sizing: border-box !important;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap br {
        display: none !important;
    }

    /* Keep the existing conversation text/link visible. */
    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap > a {
        display: block !important;
        grid-column: 2 !important;
        grid-row: 1 !important;
        min-width: 0 !important;
        max-width: none !important;
        margin: 4px 0 0 !important;
        padding: 0 !important;
        color: #17172a !important;
        font-size: 9px !important;
        font-weight: 600 !important;
        line-height: 1.35 !important;
        text-decoration: none !important;
        overflow: visible !important;
        overflow-wrap: break-word !important;
    }

    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap > a:hover {
        text-decoration: underline !important;
    }

    /* Editor stays visible BELOW the Real Conversations logo. */
    html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap [id$="_tdEdit"],
    html body.home-member .editable-zone-col .outerContWrap.slick [id$="_tdEdit"] {
        position: static !important;
        grid-column: 1 !important;
        grid-row: 2 !important;
        display: block !important;
        width: 94px !important;
        margin: 5px 0 0 !important;
        padding: 0 !important;
        z-index: 3 !important;
        box-sizing: border-box !important;
    }

    /* If the editor contains an edit link/button, keep it visible. */
    html body.home-member .editable-zone-col .outerContWrap.slick [id$="_tdEdit"] a,
    html body.home-member .editable-zone-col .outerContWrap.slick [id$="_tdEdit"] button,
    html body.home-member .editable-zone-col .outerContWrap.slick [id$="_tdEdit"] input {
        display: inline-block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    /* Give the header enough room so the conversation widget does not
       overlap the event/banner content below it. */
    html body.home-member .welcome-search-row {
        min-height: 112px !important;
    }

    html body.home-member #insideBanner {
        position: relative;
        z-index: 1;
    }

    @media (max-width: 760px) {
        html body.home-member .editable-zone-col {
            position: static;
            width: 100%;
            height: auto;
            overflow: visible !important;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick,
        html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap {
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            overflow: visible !important;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap {
            grid-template-columns: 86px minmax(0, 1fr) !important;
            grid-template-rows: 58px auto !important;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick .innerWrap img {
            width: 86px !important;
            max-width: 86px !important;
            height: 58px !important;
            max-height: 58px !important;
        }

        html body.home-member .editable-zone-col .outerContWrap.slick [id$="_tdEdit"] {
            width: 86px !important;
        }

        html body.home-member .welcome-search-row {
            min-height: 0 !important;
        }
    }

    div.quickWrapper.QuickLinkIcons
    {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        padding: 0 !important;
        margin: 16px 0 !important;
    }

    div.quickWrapper.QuickLinkIcons > a
    {
        display: flex !important;
        flex: 1 1 140px !important;
        min-width: 120px !important;
        max-width: 220px !important;
        height: 96px !important;
        box-sizing: border-box !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        border: 1px solid #ddd !important;
        border-radius: 6px !important;
        padding: 14px 8px !important;
        text-decoration: none !important;
        color: #333 !important;
        background: #fff !important;
        overflow: hidden !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon:before
    {
        content: "" !important;
        display: block !important;
        width: 24px !important;
        height: 24px !important;
        margin: 0 auto 8px auto !important;
        flex: 0 0 auto !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon:after
    {
        content: none !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon span
    {
        margin-left: 4px !important;
    }
    div.quickWrapper.QuickLinkIcons > a img,
    div.quickWrapper.QuickLinkIcons > a svg
    {
        max-width: 100% !important;
        max-height: 32px !important;
        width: auto !important;
        height: auto !important;
        object-fit: contain !important;
        flex: 0 0 auto !important;
        margin: 0 auto 6px auto !important;
    }

    div.quickWrapper.QuickLinkIcons > a > span,
    div.quickWrapper.QuickLinkIcons > a > div
    {
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        font-size: 13px !important;
    }


</style>
</head>
<body id="body" class="home-member">
