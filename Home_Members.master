                        <input type="text"
                               id="homeWhoSearch"
                               placeholder="Search members"
                               autocomplete="off"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="false"
                               aria-controls="homeWhoSuggestions" />

                        <div id="homeWhoSuggestions"
                             class="whos-who-suggestions"
                             role="listbox"
                             aria-label="Who's Who member suggestions"></div>
