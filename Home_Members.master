<%@ Register Src="~/Controls/Whatisnew/Whatisnew.ascx" TagPrefix="Hardcode" TagName="Whatisnew" %>
<%@ Register tagprefix="Hardcode" src="Controls/SearchText/SearchText.ascx" tagname="SearchText" %>
<%@ Register Src="~/Controls/Banners/Banners.ascx" TagPrefix="Hardcode" TagName="Banners" %>







<!DOCTYPE html>
<html lang="en">

