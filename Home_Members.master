    <%: System.Web.Optimization.Scripts.Render("~/bundles/slick") %>

    <script src="/Libraries/smartmenus-1.2.1/jquery.smartmenus.js"></script>
    <script>
        $(document).ready(function () {

            var searchBox = document.getElementById('homeWhoSearch');
            var directoryLink = document.getElementById('homeWhoDirectoryLink');
            var suggestions = document.getElementById('homeWhoSuggestions');

            if (searchBox && directoryLink) {

                var whoMembers = null;
                var whoRequest = null;
                var pendingSuggestionRender = null;
                var suggestionTimer = null;
                var activeSuggestion = -1;

                function directoryUrl(searchValue) {
                    var url = new URL(
                        directoryLink.getAttribute('href'),
                        window.location.href
                    );

                    url.searchParams.delete('q');
                    url.searchParams.delete('id');
                    url.searchParams.delete('member');
                    url.searchParams.set('q', searchValue);

                    return url.toString();
                }

                function closeSuggestions() {
                    if (!suggestions) {
                        return;
                    }

                    suggestions.innerHTML = '';
                    suggestions.classList.remove('is-open');
                    searchBox.setAttribute('aria-expanded', 'false');
                    searchBox.removeAttribute('aria-activedescendant');
                    activeSuggestion = -1;
                }

                function showSuggestionStatus(message) {
                    if (!suggestions) {
                        return;
                    }

                    suggestions.innerHTML = '';

                    var status = document.createElement('div');
                    status.className = 'whos-who-suggestion-status';
                    status.textContent = message;
                    suggestions.appendChild(status);
                    suggestions.classList.add('is-open');
                    searchBox.setAttribute('aria-expanded', 'true');
                }

                function extractWhoMembers(responseText) {
                    var page = new DOMParser().parseFromString(
                        responseText,
                        'text/html'
                    );
                    var data = page.getElementById('ekoWhoisWhoData');
                    var parsed;

                    if (!data) {
                        return [];
                    }

                    try {
                        parsed = JSON.parse(
                            data.textContent ||
                            data.innerText ||
                            '[]'
                        );
                    } catch (error) {
                        return [];
                    }

                    if (!Array.isArray(parsed)) {
                        return [];
                    }

                    var seen = {};

                    return parsed
                        .map(function (member) {
                            return {
                                id: member.id,
                                name: String(
                                    member.name ||
                                    member.fullName ||
                                    member.displayName ||
                                    ''
                                ).trim()
                            };
                        })
                        .filter(function (member) {
                            var key = member.name.toLowerCase();

                            if (!key || seen[key]) {
                                return false;
                            }

                            seen[key] = true;
                            return true;
                        })
                        .sort(function (a, b) {
                            return a.name.localeCompare(b.name);
                        });
                }

                function loadWhoMembers(callback) {
                    if (whoMembers !== null) {
                        callback(whoMembers);
                        return;
                    }

                    if (whoRequest) {
                        pendingSuggestionRender = callback;
                        return;
                    }

                    whoRequest = new XMLHttpRequest();
                    pendingSuggestionRender = callback;
                    whoRequest.open(
                        'GET',
                        directoryUrl(''),
                        true
                    );
                    whoRequest.withCredentials = true;

                    whoRequest.onreadystatechange = function () {
                        if (whoRequest.readyState !== 4) {
                            return;
                        }

                        if (
                            whoRequest.status >= 200 &&
                            whoRequest.status < 300
                        ) {
                            whoMembers = extractWhoMembers(
                                whoRequest.responseText
                            );
                        } else {
                            whoMembers = [];
                        }

                        whoRequest = null;

                        if (pendingSuggestionRender) {
                            var renderCallback =
                                pendingSuggestionRender;
                            pendingSuggestionRender = null;
                            renderCallback(whoMembers);
                        }
                    };

                    whoRequest.send(null);
                }

                function renderSuggestions(query, members) {
                    if (!suggestions || !query) {
                        closeSuggestions();
                        return;
                    }

                    var normalizedQuery = query.toLowerCase();
                    var matches = members
                        .filter(function (member) {
                            return member.name
                                .toLowerCase()
                                .indexOf(normalizedQuery) !== -1;
                        })
                        .sort(function (a, b) {
                            var aStarts = a.name
                                .toLowerCase()
                                .indexOf(normalizedQuery) === 0;
                            var bStarts = b.name
                                .toLowerCase()
                                .indexOf(normalizedQuery) === 0;

                            if (aStarts !== bStarts) {
                                return aStarts ? -1 : 1;
                            }

                            return a.name.localeCompare(b.name);
                        })
                        .slice(0, 8);

                    suggestions.innerHTML = '';
                    activeSuggestion = -1;

                    if (!matches.length) {
                        showSuggestionStatus('No matching members');
                        return;
                    }

                    matches.forEach(function (member, index) {
                        var item = document.createElement('a');
                        item.id = 'homeWhoSuggestion' + index;
                        item.className = 'whos-who-suggestion';
                        item.setAttribute('role', 'option');
                        item.setAttribute('aria-selected', 'false');
                        item.href = directoryUrl(member.name);
                        item.textContent = member.name;

                        item.addEventListener('click', function () {
                            closeSuggestions();
                        });

                        suggestions.appendChild(item);
                    });

                    suggestions.classList.add('is-open');
                    searchBox.setAttribute('aria-expanded', 'true');
                }

                function updateSuggestions() {
                    var searchValue = searchBox.value.trim();

                    if (!searchValue) {
                        closeSuggestions();
                        return;
                    }

                    showSuggestionStatus('Searching members…');

                    loadWhoMembers(function (members) {
                        if (searchBox.value.trim() === searchValue) {
                            renderSuggestions(searchValue, members);
                        }
                    });
                }

                directoryLink.addEventListener('click', function (event) {

                    var searchValue = searchBox.value.trim();

                    if (searchValue) {
                        event.preventDefault();

                        window.location.href = directoryUrl(searchValue);
                    }
                });

                searchBox.addEventListener('input', function () {
                    clearTimeout(suggestionTimer);
                    suggestionTimer = setTimeout(
                        updateSuggestions,
                        120
                    );
                });

                searchBox.addEventListener('keydown', function (event) {
                    var items = suggestions
                        ? suggestions.querySelectorAll(
                            '.whos-who-suggestion'
                        )
                        : [];

                    if (
                        event.key === 'ArrowDown' &&
                        items.length
                    ) {
                        event.preventDefault();
                        activeSuggestion =
                            (activeSuggestion + 1) % items.length;
                    } else if (
                        event.key === 'ArrowUp' &&
                        items.length
                    ) {
                        event.preventDefault();
                        activeSuggestion =
                            (activeSuggestion - 1 + items.length) %
                            items.length;
                    } else if (event.key === 'Escape') {
                        closeSuggestions();
                        return;
                    }

                    Array.prototype.forEach.call(
                        items,
                        function (item, index) {
                            var isActive =
                                index === activeSuggestion;
                            item.classList.toggle(
                                'is-active',
                                isActive
                            );
                            item.setAttribute(
                                'aria-selected',
                                isActive ? 'true' : 'false'
                            );
                        }
                    );

                    if (activeSuggestion >= 0 && items.length) {
                        searchBox.setAttribute(
                            'aria-activedescendant',
                            items[activeSuggestion].id
                        );
                    }

                    if (event.key === 'Enter') {
                        event.preventDefault();

                        if (
                            activeSuggestion >= 0 &&
                            items[activeSuggestion]
                        ) {
                            window.location.href =
                                items[activeSuggestion].href;
                        } else {
                            directoryLink.click();
                        }
                    }
                });

                document.addEventListener('click', function (event) {
                    if (
                        !event.target.closest('.whos-who-search')
                    ) {
                        closeSuggestions();
                    }
                });
            }

            var portalSearchBox = document.getElementById('staticWelcomeSearch');
            var portalSearchBtn = document.getElementById('btnStaticWelcomeSearch');

            if (portalSearchBox && portalSearchBtn) {

                function goToMemberSearch() {
                    var q = portalSearchBox.value.trim();

                    if (q) {
                        window.location.href = '/membersearch?q=' + encodeURIComponent(q);
                    }
                }

                portalSearchBtn.addEventListener('click', goToMemberSearch);

                portalSearchBox.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        goToMemberSearch();
                    }
                });
            }

        });
    </script>

    <%: System.Web.Optimization.Scripts.Render("~/bundles/site") %>
     <% if (Request.Url != null &&
            !Request.Url.AbsolutePath.TrimEnd('/').EndsWith(
                "/membersearch",
                StringComparison.OrdinalIgnoreCase))
        { %>
         <%: System.Web.Optimization.Scripts.Render("~/bundles/forum") %>
     <% } %>
 
    <asp:ContentPlaceHolder ID="Scripts" runat="server" />

<style>
    div.quickWrapper.QuickLinkIcons
    {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        padding: 0 !important;
        margin: 16px 0 !important;
    }

    div.quickWrapper.QuickLinkIcons > a
    {
        display: flex !important;
        flex: 1 1 140px !important;
        min-width: 120px !important;
        max-width: 220px !important;
        height: 96px !important;
        box-sizing: border-box !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        border: 1px solid #ddd !important;
        border-radius: 6px !important;
        padding: 14px 8px !important;
        text-decoration: none !important;
        color: #333 !important;
        background: #fff !important;
        overflow: hidden !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon:before
    {
        content: "" !important;
        display: block !important;
        width: 24px !important;
        height: 24px !important;
        margin: 0 auto 8px auto !important;
        flex: 0 0 auto !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon:after
    {
        content: none !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon span
    {
        margin-left: 4px !important;
    }
    div.quickWrapper.QuickLinkIcons > a img,
    div.quickWrapper.QuickLinkIcons > a svg
    {
        max-width: 100% !important;
        max-height: 32px !important;
        width: auto !important;
        height: auto !important;
        object-fit: contain !important;
        flex: 0 0 auto !important;
        margin: 0 auto 6px auto !important;
    }

    div.quickWrapper.QuickLinkIcons > a > span,
    div.quickWrapper.QuickLinkIcons > a > div
    {
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        font-size: 13px !important;
    }
</style>


</body>
</html>
