    <link href="<%: Styles.Url("~/CSS/slick") %>" type="text/css" rel="stylesheet" />
    <link href="<%: Styles.Url("~/CSS/home-member.css") %>" type="text/css" rel="stylesheet" />
    <link rel="stylesheet" href="/CSS/memberhome.css?v=<%= "" + ConfigurationManager.AppSettings.Get("CSSVersion") %>">

   <%-- <script src="https://use.fontawesome.com/8123fd5db7.js"></script>--%>

	<link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/Images/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Images/favicons/favicon-16x16.png">

