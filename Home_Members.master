    /*
       Reference screenshot alignment
       -------------------------------
       Layout-only overrides. No controls, URLs, IDs, or event handlers
       are changed by this block.
    */
    html body.home-member,
    html body.home-member #insideWrap,
    html body.home-member #insideContent,
    html body.home-member #html_content {
        background: #fff;
    }

    html body.home-member #insideWrap {
        padding-bottom: 0;
    }

    html body.home-member #mainContentInside {
        width: calc(100% - 40px);
        max-width: 1180px;
        margin: 0 auto;
    }

    html body.home-member #memberHomeFeed {
        position: relative;
    }

    html body.home-member .welcome-heading {
        padding-top: 17px;
    }

    html body.home-member .welcome-heading h1 {
        margin-bottom: 5px;
        padding-left: 9px;
        color: #4b2777;
        font-size: 18px;
        line-height: 1.2;
    }

    html body.home-member .welcome-heading h1:before {
        top: 1px;
        bottom: 1px;
        width: 3px;
        background: #39b6aa;
    }

    html body.home-member .welcome-heading .welcome-subtitle {
        color: #777783;
        font-size: 10px;
        line-height: 1.35;
    }

    html body.home-member .welcome-search-row {
        display: block;
        box-sizing: border-box;
        width: 100%;
        min-height: 34px;
        margin: 17px 0 0;
        padding-right: 293px;
    }

    html body.home-member .welcome-search-col {
        display: block;
        width: 100%;
    }

    html body.home-member .static-welcome-search {
        gap: 7px;
    }

    html body.home-member .static-welcome-search input[type="text"] {
        height: 34px;
        padding-left: 34px;
        border-color: #e3e3e8;
        border-radius: 6px;
        background-position: 11px center;
        font-size: 10px;
    }

    html body.home-member .welcome-search-btn {
        min-width: 66px;
        height: 34px;
        padding: 0 13px;
        border-radius: 6px;
        font-size: 10px;
    }

    html body.home-member .editable-zone-col {
        position: absolute;
        top: 0;
        right: 0;
        width: 273px;
        height: 98px;
    }

    html body.home-member .static-editable-zone {
        height: 98px;
        min-height: 0;
        padding: 17px 0 0 33px;
        border-left-color: #ededf0;
    }

    html body.home-member .static-editable-thumb {
        flex-basis: 94px;
        height: 63px;
        border-radius: 6px;
        background: #e4e4e9;
    }

    html body.home-member .static-editable-content {
        padding-top: 0;
    }

    html body.home-member .static-editable-eyebrow {
        margin-bottom: 5px;
        font-size: 8px;
        letter-spacing: .13em;
    }

    html body.home-member .static-editable-title {
        font-size: 10px;
        line-height: 1.25;
    }

    html body.home-member .static-editable-link {
        margin-top: 4px;
        font-size: 9px;
    }

    html body.home-member #insideBanner {
        /*
           The reference has a clear breathing space between the search
           row and the event card. Keep the banner in the normal document
           flow so existing banner content and controls are unaffected.
        */
        margin-top: 44px !important;
    }

    @media (max-width: 760px) {
        html body.home-member #mainContentInside {
            width: calc(100% - 32px);
        }

        html body.home-member .welcome-search-row {
            display: flex;
            min-height: 0;
            margin-top: 16px;
            padding-right: 0;
        }

        html body.home-member .editable-zone-col {
            position: static;
            width: auto;
            height: auto;
        }

        html body.home-member .static-editable-zone {
            height: auto;
            min-height: 58px;
            padding: 0;
        }

        html body.home-member #insideBanner {
            margin-top: 28px !important;
        }
    }

    /*
       Home widgets reference design
       -----------------------------
       Presentation-only overrides for the quick links, What's New list,
       and Who's Who card. Existing repeater output and event handlers stay
       unchanged.
    */
    html body.home-member #memberHomeMain,
    html body.home-member #memberHomeMainCol {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    html body.home-member div.quickWrapper.QuickLinkIcons {
