<style>

    html body.home-member .QuickLinkIcons a:before
    {
        background-size: contain!important;
    }

    html body.home-member .QuickLinkIcons
    {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        list-style: none !important;
        align-items: stretch !important;
        gap: 12px;
        padding: 0 !important;
        margin: 0 !important;
    }

    html body.home-member .QuickLinkIcons a
    {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center;
        flex: 1 1 auto;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 12px 8px;
    }

    .static-banner-gallery
    {
        display: flex;
        align-items: stretch;
        border: 1px solid #e2e2e2;
        border-radius: 4px;
        margin: 16px 0;
        overflow: hidden;
    }

    .static-banner-gallery .static-banner-image
    {
        flex: 0 0 40%;
        background: #ececec;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
        min-height: 220px;
    }

    .static-banner-gallery .static-banner-content
    {
        flex: 1 1 60%;
        padding: 24px;
    }

    .static-banner-gallery .static-banner-eyebrow
    {
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.05em;
        color: #6b3fa0;
        margin: 0 0 8px;
    }

    .static-banner-gallery .static-banner-content h2
    {
        margin: 0 0 12px;
    }

    .static-banner-gallery .static-banner-buttons a
    {
        display: inline-block;
        margin-right: 10px;
        padding: 10px 18px;
        border-radius: 4px;
        text-decoration: none;
    }

    .static-banner-gallery .static-banner-buttons .btn-primary
    {
        background: #6b3fa0;
        color: #fff;
    }

    .static-banner-gallery .static-banner-buttons .btn-secondary
    {
        background: #fff;
        color: #333;
        border: 1px solid #ccc;
    }

    .static-welcome-search
    {
        display: flex;
        gap: 8px;
        margin: 12px 0 20px;
        max-width: 480px;
    }

    .static-welcome-search input[type="text"]
    {
        flex: 1 1 auto;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .welcome-heading
    {
        text-align: left;
    }

    .welcome-heading h1
    {
        text-align: left;
        margin: 0 0 4px;
        font-size: 28px;
        color: #2d2d2d;
    }

    .welcome-heading .welcome-subtitle
    {
        text-align: left;
        margin: 0 0 4px;
        color: #777;
        font-size: 14px;
    }

    .welcome-search-row
    {
        display: flex;
        align-items: stretch;
        gap: 16px;
        margin: 12px 0 20px;
    }

    .welcome-search-col
    {
        flex: 1 1 66%;
        display: flex;
        align-items: center;
    }

    .welcome-search-col .static-welcome-search
    {
        margin: 0;
        max-width: none;
        width: 100%;
    }

    .editable-zone-col
    {
        flex: 1 1 34%;
    }

    .static-editable-zone
    {
        display: flex;
        gap: 10px;
        background: #f6f6f8;
        border-radius: 4px;
        padding: 10px;
        height: 100%;
        box-sizing: border-box;
    }

    .static-editable-thumb
    {
        flex: 0 0 64px;
        height: 64px;
        background: #d9d9de;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
    }

    .static-editable-content
    {
        flex: 1 1 auto;
    }

    .static-editable-eyebrow
    {
        margin: 0 0 4px;
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 0.05em;
        color: #999;
    }

    .static-editable-title
    {
        margin: 0 0 4px;
        font-size: 12px;
        font-weight: 600;
        color: #2d2d2d;
        line-height: 1.3;
    }

    .static-editable-link
    {
        font-size: 12px;
        color: #6b3fa0;
        text-decoration: none;
    }
    .welcome-search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 110px;
    height: 42px;
    padding: 0 20px;
    border: none;
    border-radius: 6px;
    background: #2f6f9f;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
}

.welcome-search-btn:hover {
    background: #255d87;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.16);
    transform: translateY(-1px);
}

.welcome-search-btn:active {
    background: #1f5278;
    transform: translateY(0);
}

.welcome-search-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(47, 111, 159, 0.25);
}

.search-icon {
    font-size: 15px;
}
</style>
</head>
<body id="body" class="home-member">
            <div role="navigation" aria-label="Skip to main content" class="nosize"><a href="#content" title="Skip to main content">Skip content</a></div>


    



	<form id="form1" runat="server">
		<asp:ScriptManager ID="sman" runat="server">
			<Scripts>
				<%--<asp:ScriptReference Path="/js/webkit.js" />--%>
			</Scripts>
		</asp:ScriptManager>

        <div>

		    <asp:ContentPlaceHolder ID="admin" runat="server" />
		    <div style="position: absolute; left: 50%; top: 85px; z-index: 999999;">
			    <Hardcode:Session runat="server" id="sessioncontrol" visible="false"></Hardcode:Session></div>
		    <Hardcode:BackToTop ID="BackToTop1" runat="server" />

             <asp:ContentPlaceHolder ID="Alert" runat="server"></asp:ContentPlaceHolder>

            <Hardcode:Header runat="server" />
	
	        <asp:ContentPlaceHolder ID="Banner" runat="server" />

				
         <div id="insideWrap" class="full-width">
            <div class="inside insideMemberHome" id="mainContentInside">
                <% if (!InsideClass.Contains("no-inside-menu"))
                {%>
                  <div id="leftMenu">
                    <asp:Literal ID="litMenuTitle" runat="server"></asp:Literal>
                    <asp:ContentPlaceHolder ID="LeftMenu" runat="server" />
                  </div>
                <%} %>

                <div id="rightInside">
                    <div id="breadcrumbs">
                        <Hardcode:Breadcrumbs runat="server" ID="Breadcrumbs" />
                    </div>
                    <div id="insideBanner">
                        <asp:ContentPlaceHolder ID="InsideBanner" runat="server" />
                    </div>
                    <div id='insideContent'>
                        <a name="content"></a>
                        <div id="html_content" class="memberIntro">
                            <div id="memberHomeFeed">
                                    <div class="welcome-heading">
                                        <asp:Literal runat="server" ID="litWelcome"></asp:Literal>
                                        <p class="welcome-subtitle">Here's what's new since your last visit.</p>
                                    </div>
                                <% if (!IsPncaOnly)
                                    { %>

                                <div class="welcome-search-row">
                                    <div class="welcome-search-col">
                                        <div class="static-welcome-search">
                                            <input type="text" id="staticWelcomeSearch" name="staticWelcomeSearch" placeholder="Search the member portal" />
                                            <button type="button" id="btnStaticWelcomeSearch" class="welcome-search-btn">
    <span class="search-icon">🔍</span>
    Search
</button>
                                        </div>
                                    </div>
                                    <div class="editable-zone-col">
                                        <div class="static-editable-zone">
                                            <div class="static-editable-thumb">
                                                <span class="static-editable-play">&#9658;</span>
                                            </div>
                                            <div class="static-editable-content">
                                                <p class="static-editable-eyebrow">Real Conversations</p>
                                                <p class="static-editable-title">&ldquo;Reimagining</p>
                                                <p class="static-editable-title">Transitions:</p>
                                                <p class="static-editable-title">Supporting Youth int</p>
                                                <p class="static-editable-title">Adult Services&rdquo;</p>
                                                <a href="#" class="static-editable-link">Watch now &rarr;</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="static-banner-gallery">
                                    <div class="static-banner-image">Image</div>
                                    <div class="static-banner-content">
                                        <p class="static-banner-eyebrow">Event</p>
                                        <h2>2026 EKO Annual Conference &mdash; Registration Now Open</h2>
                                        <p>Join members across Ontario for three days of learning and collaboration in</p>
                                        <p>pediatric health. Early bird closes August 15.</p>
                                        <div class="static-banner-buttons">
                                            <a href="#" class="btn-primary">Register now</a>
                                            <a href="#" class="btn-secondary">View details</a>
                                        </div>
                                    </div>
                                </div>

                                <div id="memberHomeMain" class="memberHomeMain">
                                    <div id="memberHomeMainCol" class="memberHomeMainCol">
                                        <Hardcode:QuickLinks runat="server" ID="QuickLinks" parameter="1" />

                                        <Hardcode:Whatisnew runat="server" ID="Whatisnew" />
                                    </div>
                                </div>

                                <%}
                                    else
                                    { %>
                                <Hardcode:Content runat="server" ID="Content1" parameters="10517" />
                                <%} %>
                            </div>
                        </div>  
                    </div>
                </div>

		        </div>
            </div>
            <div id="insideMemberSlider">
                <Hardcode:EKO_Directory runat="server" ID="EKO_Directory" />
            </div>

       
        <Hardcode:Footer runat="server" ID="Footer1" />

        </div>
        
         
    </form>
 
    <%: System.Web.Optimization.Scripts.Render("~/bundles/slick") %>

    <script src="/Libraries/smartmenus-1.2.1/jquery.smartmenus.js"></script>

    <%: System.Web.Optimization.Scripts.Render("~/bundles/site") %>
    <%: System.Web.Optimization.Scripts.Render("~/bundles/forum") %>
 
    <asp:ContentPlaceHolder ID="Scripts" runat="server" />

<div class="preLoad">
    <img src="/images/mh-notifications-hover.svg" alt="">
    <img src="/images/mh-resources-hover.svg" alt="">
    <img src="/images/mh-watercooler-hover.svg" alt="">
    <img src="/images/mh-news-hover.svg" alt="">
    <img src="/images/mh-account-hover.svg" alt="">
</div>

<style>
    div.quickWrapper.QuickLinkIcons
    {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        padding: 0 !important;
        margin: 16px 0 !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon
    {
        display: flex !important;
        flex: 1 1 140px !important;
        min-width: 120px !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        border: 1px solid #ddd !important;
        border-bottom: 1px solid #ddd !important;
        border-radius: 6px !important;
        padding: 14px 8px !important;
        text-decoration: none !important;
        color: #333 !important;
        background: #fff !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon:before
    {
        content: "" !important;
        display: block !important;
        width: 24px !important;
        height: 24px !important;
        margin: 0 auto 8px auto !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon:after
    {
        content: none !important;
    }

    div.quickWrapper.QuickLinkIcons a.qLinkIcon span
    {
        margin-left: 4px !important;
    }
</style>


</body>
</html>
